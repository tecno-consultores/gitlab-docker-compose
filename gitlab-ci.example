######################################### FINAL

final_real_canary:
  cache: []
  stage: final
  only:
    - canary
  tags:
    - karateiron
  script:
    - rm -f /home/gitlab-runner/*.dump
    - PGPASSWORD=$sqlironpro pg_dump -Fc -h 54.219.246.162 -p 5004 -U admin -d ABCopilot_db > /home/gitlab-runner/abcopilot-pro.dump
    - PGPASSWORD=$sqlironpro pg_restore --single-transaction -h 54.219.246.162 -p 5004 -U admin -d ABCopilot_db /home/gitlab-runner/abcopilot-pro.dump

######################################### MIGRACION PRO

migracion_real:
  cache: []
  stage: migracion
  only:
    - main
    - canary
  tags:
    - iron-api-pro-new-8
  script:
    - docker exec -t app-iron-pro php artisan migrate -n --force

######################################### DB PRE

final_real_PRE:
  cache: []
  stage: final
  only:
    - stagin
  tags:
    - karateiron
  script:
    - rm -f /home/gitlab-runner/*.dump
    - PGPASSWORD=$sqlironpro pg_dump -Fc -h 13.57.10.229 -p 5004 -U admin -d ABCopilot_db > /home/gitlab-runner/abcopilot-pro.dump
    - PGPASSWORD=$sqlironpre pg_restore --single-transaction -h 204.236.137.27 -p 5005 -U admin -d ABCopilot_db /home/gitlab-runner/abcopilot-pro.dump

######################################### MIGRACION PRE

migracion_pre:
  cache: []
  stage: migracion
  only:
    - stagin
  tags:
    - ironapipremigrated2
  script:
    - docker exec -t app-iron-pre php artisan migrate -n --force


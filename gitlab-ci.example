sql_karate_pro:
  cache: []
  stage: sql
  only:
    - main
  tags:
    - karateiron
  script:
    - rm -f /home/gitlab-runner/*.dump
    - PGPASSWORD=$sqlironpro pg_dump -Fc -h 13.57.10.229 -p 5004 -U admin -d ABCopilot_db > /home/gitlab-runner/abcopilot-pro.dump
    - PGPASSWORD=$sqlironpro pg_restore --single-transaction -h 127.0.0.1 -p 9002 -U admin -d ABCopilot_db /home/gitlab-runner/abcopilot-pro.dump
    - docker exec -t app-iron-test php artisan migrate -n --force

sql_karate_canary:
  cache: []
  stage: sql
  only:
    - canary
  tags:
    - karateiron
  script:
    - rm -f /home/gitlab-runner/*.dump
    - PGPASSWORD=$sqlironpro pg_dump -Fc -h 54.215.244.116 -p 5004 -U admin -d ABCopilot_db > /home/gitlab-runner/abcopilot-pro.dump
    - PGPASSWORD=$sqlironpro pg_restore --single-transaction -h 127.0.0.1 -p 9002 -U admin -d ABCopilot_db /home/gitlab-runner/abcopilot-pro.dump
    - docker exec -t app-iron-test php artisan migrate -n --force


